{
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5001"
      },
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "FileEntropy": "",
  "DataProtectionScope": "CurrentUser",

  "DefaultConnectorId": "onedrive",

  "Connector": {
    "filesystem": {
      "Enabled": "true",
      "OutputPath": "C:\\SESARWebHook\\Output\\",
      "CreateSubfolders": "true"
    },
    "zoho-crm": {
      "Enabled": "false",
      "Domain": "https://www.zohoapis.com",
      "TargetModule": "Leads"
    },
    "sharepoint": {
      "Enabled": "true",
      "SiteUrl": "https://secureexchanges.sharepoint.com/",
      "DocumentLibrary": "/Shared Documents"
    },
    "dynamics": {
      "Enabled": "false",
      "ResourceUrl": "",
      "EntityName": "contacts"
    },
    "onedrive": {
      "Enabled": "true",
      "CreateSubFolders": "true"
    }
  },

  "EnableDetailedLogging": "true",
  "LogPath": "C:\\SESARWebHook\\Logs\\",
  "EnableDebugEndpoints": "false"
}
